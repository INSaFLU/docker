# .env
# INSaFLU deploy configuration, read by docker compose. Host: cn00.posit.vetinst.no
# Required variables are enforced by ${VAR:?} guards in docker-compose.yml:
# erasing one fails the whole file at startup.
# The django section is passed into insaflu-server as environment and read by
# python-decouple, which checks the environment before the baked-in .env file,
# so these take effect on restart, no rebuild. Secrets (SECRET_KEY, DB_PASSWORD)
# and the email block stay in components/insaflu-server/configs/insaflu.env
# until they get their own mechanism.
# fork: github.com/georgemarselis-nvi/insaflu-docker

IMAGE=insaflu-server
APP_USER=flu_user

## List of time zones https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

TIMEZONE=Europe/Oslo
USERNAME_IMAGE=nvi-insaflu
# BASE_PATH_DATA=/data
BASE_PATH_DATA=/data/tools/insaflu
APP_PORT=80

### django

## hosts allowed to reach the site, * because apache fronts django and hostnames vary per deploy
ALLOWED_HOSTS=*
DEBUG=True
ADMIN_ENABLED=False
SECURE_SSL_REDIRECT=False
INSTITUTION_NAME=Norwegian Veterinary Institute
INSTITUTION_WEB_SITE=https://www.vetinst.no/

## database connection, password stays in insaflu.env
DB_NAME=insaflu_db
DB_USER=flu_user
DB_HOST=db_insaflu
DB_PORT=5432

## threads per tool; cn00 has 128 cores, upstream defaults were 3 and 5
THREADS_TO_RUN_FAST=3
THREADS_TO_RUN_SLOW=5

## upload and sequence limits in bytes; upstream shipped 604857600 (576MB)
## per fastq, Øivind's runs are 10 to 20 times that
MAX_FASTQ_FILE_UPLOAD=12884901888
DOWN_SIZE_FASTQ_FILES=False
MAX_FASTQ_FILE_WITH_DOWNSIZE=12884901888
MAX_REF_FASTA_FILE=524280
MAX_REF_GENBANK_FILE=1048576
MAX_LENGTH_SEQUENCE_TOTAL_FROM_FASTA=524280
MAX_LENGTH_SEQUENCE_TOTAL_FROM_CONSENSUS_FASTA=104857600
MAX_CONSENSUS_FASTA_FILE=104857600

## front page toggles
ADD_GOOGLE_ANALYTICS=False
SHOW_LOGIN_ANONYMOUS=False
SHOW_VIDEO_TUTORIAL=False
## WARNING: the workflow cards render on the front page regardless of this
## value; the template or the settings.py default ignores it. Left as upstream
## shipped it until that is traced.
SHOW_IMAGES_MAIN_PAGE=False

### televir

TELEVIR_IMAGE=televir-image
# TELEVIR_BASE_PATH_DATA=/data/televir
TELEVIR_BASE_PATH_DATA=/data/tools/insaflu/televir
TELEVIR_PORT=8080
